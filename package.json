{
  "name": "mixtle-al-rescate",
  "private": true,
  "version": "0.1.0",
  "description": "Prototipo de videojuego educativo para Eco Urban A.C.: cuidar a los animales del parque y aprender a separar la basura.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "verificar": "npm run typecheck && npm run lint && npm test && npm run build && npm run presupuesto",
    "voz:preparar": "node scripts/voz/preparar.mjs",
    "voz:muestras": "node scripts/voz/muestras.mjs",
    "musica:muestras": "node scripts/musica/muestras.mjs",
    "voz:generar": "node scripts/voz/generar.mjs",
    "voz:lista": "node scripts/voz/lista.mjs",
    "sonidos:generar": "node scripts/sonidos/generar.mjs",
    "musica:instalar": "node scripts/musica/instalar.mjs",
    "capturas": "node scripts/capturas.mjs",
    "voz:usar": "node scripts/voz/usar.mjs",
    "voz:silencio": "node scripts/voz/medir-silencio.mjs",
    "actualizacion:probar": "node scripts/probar-actualizacion.mjs",
    "docs:direccion": "node scripts/direccion-visual.mjs",
    "marca:generar": "node scripts/marca.mjs",
    "presupuesto": "node scripts/presupuesto.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "howler": "^2.2.4",
    "idb-keyval": "^6.3.0",
    "motion": "^14.7.1",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "opentype.js": "^1.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
